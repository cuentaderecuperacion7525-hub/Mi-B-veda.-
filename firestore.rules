rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper to check user authentication
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['id', 'firstName', 'lastName', 'birthDate', 'age', 'email', 'emailVerified', 'createdAt'])
        && data.keys().hasOnly(['id', 'firstName', 'lastName', 'birthDate', 'age', 'email', 'emailVerified', 'createdAt', 'updatedAt'])
        && data.id is string
        && data.firstName is string
        && data.firstName.size() >= 1
        && data.lastName is string
        && data.lastName.size() >= 1
        && data.birthDate is string
        && data.birthDate.size() == 10
        && data.age is number
        && data.age >= 0
        && data.email is string
        && data.emailVerified is bool
        && data.createdAt is string;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(request.resource.data) && request.resource.data.id == userId;
      allow update: if isOwner(userId) && isValidUser(request.resource.data) && request.resource.data.id == userId;
      allow delete: if isOwner(userId);
    }
  }
}
